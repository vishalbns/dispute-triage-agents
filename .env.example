# Model backend: "bedrock" (target) or "anthropic" (runs without AWS)
MODEL_PROVIDER=bedrock
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Only needed when MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_ID=claude-sonnet-4-5

# Embeddings: "local" (Chroma built-in, no AWS) or "titan" (Bedrock)
EMBEDDINGS=local

# Optional Bedrock Guardrail. Unset means local redaction only.
# GUARDRAIL_ID=gr-abc123
# GUARDRAIL_VERSION=3
